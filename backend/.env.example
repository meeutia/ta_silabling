# ─────────────────────────────────────────────────────────────────────────────
# EMAIL NOTIFICATION (hanya untuk pelanggan, pegawai internal TIDAK dikirim email)
# Jika ENABLE_EMAIL_NOTIFICATIONS=false, notifikasi hanya muncul di website.
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_EMAIL_NOTIFICATIONS=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=change_this_smtp_password
MAIL_FROM=SILABLING <noreply@example.com>

# ─────────────────────────────────────────────────────────────────────────────
# BROWSER PUSH NOTIFICATION (hanya untuk pegawai internal lab)
# Pelanggan TIDAK menggunakan push notification.
# Langkah setup:
#   1. npm install               (pastikan web-push terinstall)
#   2. npm run push:keys         (generate VAPID_PUBLIC_KEY dan VAPID_PRIVATE_KEY)
#   3. Isi ketiga variabel di bawah, lalu set ENABLE_PUSH_NOTIFICATIONS=true
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_PUSH_NOTIFICATIONS=false

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@silabling.local
