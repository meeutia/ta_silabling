@startuml
title act C.20. Mengelola Regulasi Baku Mutu

|Administrator|
start
:Buka menu Kelola Parameter;

|Sistem|
:Tampilkan daftar regulasi baku mutu;

|Administrator|
:Memilih aksi yang akan dilakukan;

if (Tambah regulasi baru?) then (Iya)
  :Klik tombol tambah;

  |Sistem|
  :Tampilkan form tambah regulasi;

  |Administrator|
  :Isi nama dan data regulasi;
  :Klik simpan;

  |Sistem|
  :Validasi data;

  if (Data valid?) then (Iya)
    :Simpan regulasi baru;
    :Tampilkan pesan regulasi berhasil ditambahkan;
  else (Tidak)
    :Tampilkan pesan validasi;

    |Administrator|
    :Perbaiki data;
  endif

else if (Ubah regulasi?) then (Iya)
  :Pilih regulasi yang akan diubah;
  :Klik ubah;

  |Sistem|
  :Tampilkan form ubah regulasi;

  |Administrator|
  :Perbarui data regulasi;
  :Klik simpan;

  |Sistem|
  :Validasi data;

  if (Data valid?) then (Iya)
    :Simpan perubahan regulasi;
    :Tampilkan pesan regulasi berhasil diperbarui;
  else (Tidak)
    :Tampilkan pesan validasi;

    |Administrator|
    :Perbaiki data;
  endif

else (Hapus regulasi)
  :Pilih regulasi yang akan dihapus;
  :Klik hapus;

  |Sistem|
  :Tampilkan konfirmasi penghapusan;

  |Administrator|
  :Konfirmasi penghapusan;

  |Sistem|
  :Hapus regulasi;
  :Tampilkan pesan regulasi berhasil dihapus;
endif

stop
@enduml
