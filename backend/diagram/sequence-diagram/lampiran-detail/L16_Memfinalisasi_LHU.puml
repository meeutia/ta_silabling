    @startuml
    title Sequence Diagram Memfinalisasi LHU
    autonumber
    skinparam sequenceMessageAlign center
    skinparam responseMessageBelowArrow true
    skinparam BoxPadding 10
    hide footbox

    actor "Pengendalian Mutu" as QC
boundary "QcLhuPage\nQcLhuDetailModal" as FE
control "lhuReviewApi" as Api
control "LhuController\n.finalizeLhu()" as Controller
control "LhuService\n.finalizeLhu()" as LhuService
control "LhuFinalizationService\n.finalizeLhu()" as FinalizationService
control "LhuPdfService\n.generateFinalLhuPdf()" as PdfService
database "Sequelize Models\nSampel, Lhu, LhuSampel, DetailLhu" as DB
control "WorkflowLogService" as Log
control "NotificationService" as Notif

QC -> FE: Memilih sampel, paket baku mutu, dan urutan parameter
FE -> Api: getLhuFinalizationPreview(identifier, idPktBm, sampleNos)
Api -> Controller: GET /lhu/finalization/preview
Controller -> LhuService: previewFinalization(identifier, idPktBm, sampleNos)
LhuService -> FinalizationService: previewFinalization(...)
FinalizationService -> DB: ambil sampel, hasil disetujui Kasi, paket BM
FinalizationService --> FE: preview detail LHU

QC -> FE: Klik Finalisasi
FE -> Api: finalizeLhu(payload)
Api -> Controller: POST /lhu/finalization/finalize
activate Controller
Controller -> LhuService: finalizeLhu(identifier, body, qcNik)
LhuService -> FinalizationService: finalizeLhu(identifier, payload, qcNik)
activate FinalizationService
FinalizationService -> DB: begin transaction
FinalizationService -> DB: resolveSelectedSampleInfos() dan dedupe sampleNos
FinalizationService -> DB: getBmInfo(idPktBm)
FinalizationService -> FinalizationService: validateSampleCompatibilityForLhu()
FinalizationService -> DB: buildLhuPreviewDetails()
FinalizationService -> DB: create/update Lhu
note right of DB: status = Disahkan
FinalizationService -> DB: replace LhuSampel dan DetailLhu
FinalizationService -> PdfService: generateFinalLhuPdf(nomorLhu, transaction)
PdfService -> DB: ambil data LHU dan detail
PdfService --> FinalizationService: filePath final PDF
FinalizationService -> DB: update file_lhu_path
FinalizationService -> Log: logStatusTransition(MEMBUAT/MEMPERBARUI_LHU_FINAL)
FinalizationService -> DB: commit transaction
FinalizationService --> LhuService: nomorLhu, filePath, status Disahkan
deactivate FinalizationService
LhuService --> Controller: result
Controller -> Notif: notifyAdminWhenRequestLhusComplete(nomorLhu)
Controller --> Api: successResponse
Api --> FE: data LHU final
FE --> QC: Menampilkan finalisasi berhasil

deactivate Controller
    @enduml
